{
  "_instrucciones": [
    "1. Ve a https://console.cloud.google.com → APIs y servicios → Credenciales",
    "2. Crea credenciales OAuth 2.0 → Aplicación de escritorio",
    "3. Descarga el JSON y renómbralo a 'credentials.json'",
    "4. Colócalo en ~/.config/goFarmacia/credentials.json",
    "5. En 'URIs de redirección autorizados' agrega: http://localhost:8094/gmail/oauth2/callback",
    "6. Habilita la API de Gmail en tu proyecto de Google Cloud"
  ],
  "installed": {
    "client_id": "TU_CLIENT_ID.apps.googleusercontent.com",
    "project_id": "tu-proyecto-id",
    "auth_uri": "https://accounts.google.com/o/oauth2/auth",
    "token_uri": "https://oauth2.googleapis.com/token",
    "auth_provider_x509_cert_url": "https://www.googleapis.com/oauth2/v1/certs",
    "client_secret": "TU_CLIENT_SECRET",
    "redirect_uris": ["http://localhost:8094/gmail/oauth2/callback"]
  }
}
